# Copia este archivo como `local.properties` (ignorado por Git) y completa tus valores locales.
# En Windows escapa la barra invertida en `sdk.dir` (ejemplo: C\:\\Users\\Usuario\\AppData\\Local\\Android\\Sdk).

sdk.dir=C\:\\Users\\TU_USUARIO\\AppData\\Local\\Android\\Sdk
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_PUBLISHABLE_OR_ANON_KEY
